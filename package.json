{
  "name": "@rmartz/semantic-release-ci",
  "version": "0.0.0",
  "private": true,
  "description": "Shared semantic-release for the fleet: one centrally-tested release toolchain, delivered as reusable release and release-check workflows kept current by Dependabot.",
  "keywords": [
    "ci",
    "semantic-release",
    "release",
    "changelog",
    "github-actions",
    "reusable-workflow"
  ],
  "homepage": "https://github.com/rmartz/semantic-release-ci#readme",
  "bugs": {
    "url": "https://github.com/rmartz/semantic-release-ci/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmartz/semantic-release-ci.git"
  },
  "scripts": {
    "release-check": "node src/bin/release-check.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "cosmiconfig": "^9.0.2",
    "semantic-release": "^25.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "overrides": {
      "@semantic-release/release-notes-generator>conventional-changelog-writer": "^9.2.1"
    }
  }
}
